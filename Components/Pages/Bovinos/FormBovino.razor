@page "/bovinos/novo"
@page "/bovinos/editar/{Id:int}"
@inject IDbContextFactory<GadoContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>@Titulo | Gado em Dia</PageTitle>

<div class="cabecalho-pagina">
    <div>
        <h1>@Titulo</h1>
        <p class="text-muted mb-0">Só a identificação e o sexo são obrigatórios.</p>
    </div>
    <a href="bovinos" class="btn btn-light">
        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Voltar
    </a>
</div>

@if (naoEncontrado)
{
    <RegistroNaoEncontrado Mensagem="Bovino não encontrado." VoltarUrl="bovinos" />
}
else if (bovino is null)
{
    <p class="text-muted">Carregando...</p>
}
else
{
    <Cartao Titulo="Dados do animal" Icone="tags">
        <FormularioBovino Bovino="bovino" ErroIdentificacao="@erroIdentificacao" OnSalvar="SalvarAsync" />
    </Cartao>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private Bovino? bovino;
    private bool naoEncontrado;
    private string? erroIdentificacao;

    private string Titulo => Id is null ? "Novo bovino" : "Editar bovino";

    protected override async Task OnParametersSetAsync()
    {
        naoEncontrado = false;
        erroIdentificacao = null;

        if (Id is null)
        {
            bovino = new Bovino();
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        bovino = await db.Bovinos.AsNoTracking().FirstOrDefaultAsync(b => b.Id == Id);
        naoEncontrado = bovino is null;
    }

    private async Task SalvarAsync()
    {
        if (bovino is null)
        {
            return;
        }

        erroIdentificacao = null;
        bovino.Identificacao = bovino.Identificacao.Trim();
        bovino.Raca = string.IsNullOrWhiteSpace(bovino.Raca) ? null : bovino.Raca.Trim();
        bovino.Observacoes = string.IsNullOrWhiteSpace(bovino.Observacoes) ? null : bovino.Observacoes.Trim();

        await using var db = await DbFactory.CreateDbContextAsync();

        bool identificacaoRepetida = await db.Bovinos
            .AnyAsync(b => b.Id != bovino.Id && b.Identificacao == bovino.Identificacao);
        if (identificacaoRepetida)
        {
            erroIdentificacao = "Já existe um bovino com essa identificação.";
            return;
        }

        if (bovino.Id == 0)
        {
            db.Bovinos.Add(bovino);
        }
        else
        {
            db.Bovinos.Update(bovino);
        }

        await db.SaveChangesAsync();
        Navigation.NavigateTo($"bovinos/{bovino.Id}");
    }
}
