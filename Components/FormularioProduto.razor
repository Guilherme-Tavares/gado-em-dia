<EditForm Model="Produto" OnValidSubmit="OnSalvar">
    <DataAnnotationsValidator />
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Nome *</label>
            <InputText class="form-control" @bind-Value="Produto.Nome" />
            <ValidationMessage For="() => Produto.Nome" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Tipo *</label>
            <InputSelect class="form-select" @bind-Value="Produto.Tipo">
                @foreach (var tipo in Enum.GetValues<TipoProduto>())
                {
                    <option value="@tipo">@tipo.ObterNome()</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-4">
            <label class="form-label">Finalidade</label>
            <InputText class="form-control" @bind-Value="Produto.Finalidade" />
            <ValidationMessage For="() => Produto.Finalidade" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Fabricante</label>
            <InputText class="form-control" @bind-Value="Produto.Fabricante" />
            <ValidationMessage For="() => Produto.Fabricante" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Unidade *</label>
            <InputText class="form-control" @bind-Value="Produto.Unidade" />
            <ValidationMessage For="() => Produto.Unidade" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Intervalo de reforço (dias)</label>
            <InputNumber class="form-control" @bind-Value="Produto.IntervaloReforcoDias" />
            <ValidationMessage For="() => Produto.IntervaloReforcoDias" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Carência (dias)</label>
            <InputNumber class="form-control" @bind-Value="Produto.CarenciaDias" />
            <ValidationMessage For="() => Produto.CarenciaDias" />
        </div>
    </div>
    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary" type="submit">Salvar</button>
        <a href="produtos" class="btn btn-light">Cancelar</a>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public Produto Produto { get; set; } = default!;

    [Parameter]
    public EventCallback OnSalvar { get; set; }
}
