<div class="card">
    <div class="card-body text-center py-5">
        <i class="bi bi-search fs-1 text-muted d-block mb-3" aria-hidden="true"></i>
        <p class="mb-3">@Mensagem</p>
        <a href="@VoltarUrl" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Voltar para a lista
        </a>
    </div>
</div>

@code {
    [Parameter]
    public string Mensagem { get; set; } = "Registro não encontrado.";

    [Parameter, EditorRequired]
    public string VoltarUrl { get; set; } = "";
}
