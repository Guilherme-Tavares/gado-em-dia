@if (!Bovinos.Any())
{
    <AvisoVazio Mensagem="Nenhum bovino encontrado." />
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Identificação</th>
                    <th scope="col">Sexo</th>
                    <th scope="col">Categoria</th>
                    <th scope="col">Raça</th>
                    <th scope="col">Situação</th>
                    @if (Resumos is not null)
                    {
                        <th scope="col">Sanitário</th>
                    }
                    <th scope="col"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bovino in Bovinos)
                {
                    <tr>
                        <td class="fw-semibold">
                            <a href="bovinos/@bovino.Id" class="text-reset text-decoration-none">@bovino.Identificacao</a>
                        </td>
                        <td>@bovino.Sexo?.ObterNome()</td>
                        <td>@(bovino.Categoria?.ObterNome() ?? "—")</td>
                        <td>@(bovino.Raca ?? "—")</td>
                        <td><span class="badge rounded-pill @ClasseSituacao(bovino.Situacao)">@bovino.Situacao.ObterNome()</span></td>
                        @if (Resumos is not null)
                        {
                            <td>
                                @if (Resumos.TryGetValue(bovino.Id, out var resumo) && (resumo.EmCarencia || resumo.PiorReforco is not null))
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (resumo.EmCarencia)
                                        {
                                            <SeloSituacao Situacao="StatusSanitario.EmCarencia" />
                                        }
                                        @if (resumo.PiorReforco is StatusSanitario pior)
                                        {
                                            <SeloSituacao Situacao="pior" />
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        }
                        <td>
                            <BotoesAcoes VisualizarUrl="@($"bovinos/{bovino.Id}")"
                                         EditarUrl="@($"bovinos/editar/{bovino.Id}")"
                                         OnExcluir="() => OnExcluir.InvokeAsync(bovino)" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IEnumerable<Bovino> Bovinos { get; set; } = [];

    [Parameter]
    public EventCallback<Bovino> OnExcluir { get; set; }

    // Resumo sanitário por Id de bovino. Se for nulo, a coluna "Sanitário" não aparece.
    [Parameter]
    public Dictionary<int, ResumoSanitario>? Resumos { get; set; }

    private static string ClasseSituacao(SituacaoBovino situacao) => situacao switch
    {
        SituacaoBovino.Ativo => "text-bg-success",
        SituacaoBovino.Vendido => "text-bg-secondary",
        _ => "text-bg-dark"
    };
}
