@page "/bovinos"
@inject IDbContextFactory<GadoContext> DbFactory

<PageTitle>Bovinos | Gado em Dia</PageTitle>

<div class="cabecalho-pagina">
    <div>
        <h1>Bovinos</h1>
        <p class="text-muted mb-0">Animais do rebanho</p>
    </div>
    <a href="bovinos/novo" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Novo bovino
    </a>
</div>

@if (mensagemErro is not null)
{
    <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        <div class="flex-grow-1">@mensagemErro</div>
        <button type="button" class="btn-close" aria-label="Fechar" @onclick="() => mensagemErro = null"></button>
    </div>
}

<Cartao>
    <div class="row g-2 mb-3">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text bg-transparent"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input class="form-control" placeholder="Buscar por identificação" aria-label="Buscar por identificação"
                       @bind="busca" @bind:event="oninput" />
            </div>
        </div>
        <div class="col-md-4">
            <select class="form-select" aria-label="Filtrar por situação" @bind="filtroSituacao">
                @foreach (var situacao in Enum.GetValues<SituacaoBovino>())
                {
                    <option value="@situacao">@(situacao.ObterNome())s</option>
                }
                <option value="">Todas as situações</option>
            </select>
        </div>
    </div>

    @if (bovinos is null)
    {
        <p class="text-muted">Carregando...</p>
    }
    else
    {
        <TabelaBovinos Bovinos="BovinosFiltrados" Resumos="resumos" OnExcluir="PedirExclusao" />
    }
</Cartao>

<ConfirmarExclusao Visivel="bovinoParaExcluir is not null" OnConfirmar="ExcluirAsync" OnCancelar="CancelarExclusao">
    Deseja excluir o bovino <strong>@bovinoParaExcluir?.Identificacao</strong>? Esta ação não pode ser desfeita.
</ConfirmarExclusao>

@code {
    private List<Bovino>? bovinos;
    private Dictionary<int, ResumoSanitario> resumos = new();
    private string busca = "";
    private string filtroSituacao = nameof(SituacaoBovino.Ativo);
    private Bovino? bovinoParaExcluir;
    private string? mensagemErro;

    private IEnumerable<Bovino> BovinosFiltrados =>
        (bovinos ?? new())
            .Where(b => string.IsNullOrWhiteSpace(busca)
                || b.Identificacao.Contains(busca.Trim(), StringComparison.OrdinalIgnoreCase))
            .Where(b => filtroSituacao == "" || b.Situacao.ToString() == filtroSituacao);

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        bovinos = await db.Bovinos
            .OrderBy(b => b.Identificacao)
            .ToListAsync();

        // Aplicações com os relacionados carregados, para a SituacaoSanitaria calcular os selos.
        var aplicacoes = await db.Aplicacoes
            .Include(a => a.Bovino)
            .Include(a => a.Itens)
                .ThenInclude(i => i.Produto)
            .AsNoTracking()
            .ToListAsync();

        resumos = SituacaoSanitaria.Resumir(aplicacoes, DateTime.Today);
    }

    private void PedirExclusao(Bovino bovino)
    {
        mensagemErro = null;
        bovinoParaExcluir = bovino;
    }

    private void CancelarExclusao()
    {
        bovinoParaExcluir = null;
    }

    private async Task ExcluirAsync()
    {
        if (bovinoParaExcluir is null)
        {
            return;
        }

        var bovino = bovinoParaExcluir;
        bovinoParaExcluir = null;

        await using var db = await DbFactory.CreateDbContextAsync();

        bool temHistorico = await db.Aplicacoes.AnyAsync(a => a.BovinoId == bovino.Id);
        if (temHistorico)
        {
            mensagemErro = $"O bovino {bovino.Identificacao} tem aplicações registradas e não pode ser excluído. " +
                           "Se ele saiu do rebanho, edite o cadastro e mude a situação para Vendido ou Morto.";
            return;
        }

        db.Bovinos.Remove(bovino);
        await db.SaveChangesAsync();
        bovinos?.Remove(bovino);
    }
}
