<EditForm Model="Aplicacao" OnValidSubmit="OnSalvar">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Data *</label>
            <InputDate class="form-control" @bind-Value="Aplicacao.Data" />
            <ValidationMessage For="() => Aplicacao.Data" />
        </div>
        <div class="col-md-8">
            <label class="form-label">Aplicador *</label>
            <InputSelect class="form-select" @bind-Value="Aplicacao.AplicadorId">
                <option value="0">Selecione...</option>
                @foreach (var aplicador in Aplicadores)
                {
                    <option value="@aplicador.Id">@aplicador.Nome</option>
                }
            </InputSelect>
            <ValidationMessage For="() => Aplicacao.AplicadorId" />
        </div>
        <div class="col-12">
            <label class="form-label">Observação</label>
            <InputTextArea class="form-control" @bind-Value="Aplicacao.Observacao" rows="2" />
        </div>
    </div>
    <hr />
    <h2 class="h6">Animais *</h2>
    @foreach (var bovino in Bovinos)
    {
        <div class="form-check">
            <input class="form-check-input" type="checkbox" checked="@BovinosSelecionados.Contains(bovino.Id)" @onchange="e => OnSelecionarBovino.InvokeAsync((bovino.Id, (bool)e.Value!))" id="b@bovino.Id" />
            <label class="form-check-label" for="b@bovino.Id">@bovino.Identificacao</label>
        </div>
    }
    <h2 class="h6 mt-3">Produtos *</h2>
    @foreach (var produto in Produtos)
    {
        <div class="row align-items-center mb-2">
            <div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" checked="@ProdutosSelecionados.Contains(produto.Id)" @onchange="e => OnSelecionarProduto.InvokeAsync((produto.Id, (bool)e.Value!))" id="p@produto.Id" /><label class="form-check-label" for="p@produto.Id">@produto.Nome (@produto.Unidade)</label></div></div>
            @if (ProdutosSelecionados.Contains(produto.Id))
            {
                <div class="col-md-3">
                    <input type="number"
                           class="form-control"
                           value="@ObterDose(produto.Id)"
                           placeholder="Dose"
                           step="0.01"
                           @onchange="e => OnAlterarDose.InvokeAsync((produto.Id, e.Value?.ToString()))" />
                </div>
            }
        </div>
    }
    @if (MensagemErro is not null)
    {
        <div class="validation-message mt-2">@MensagemErro</div>
    }
    <div class="d-flex gap-2 mt-4"><button type="submit" class="btn btn-primary">Salvar</button><a href="aplicacoes" class="btn btn-light">Cancelar</a></div>
</EditForm>

@code {
    [Parameter, EditorRequired] public Aplicacao Aplicacao { get; set; } = default!;
    [Parameter, EditorRequired] public List<Bovino> Bovinos { get; set; } = [];
    [Parameter, EditorRequired] public List<Aplicador> Aplicadores { get; set; } = [];
    [Parameter, EditorRequired] public List<Produto> Produtos { get; set; } = [];
    [Parameter, EditorRequired] public HashSet<int> BovinosSelecionados { get; set; } = [];
    [Parameter, EditorRequired] public HashSet<int> ProdutosSelecionados { get; set; } = [];
    [Parameter, EditorRequired] public Dictionary<int, decimal?> Doses { get; set; } = [];
    [Parameter] public string? MensagemErro { get; set; }
    [Parameter] public EventCallback OnSalvar { get; set; }
    [Parameter] public EventCallback<(int Id, bool Marcado)> OnSelecionarBovino { get; set; }
    [Parameter] public EventCallback<(int Id, bool Marcado)> OnSelecionarProduto { get; set; }
    [Parameter] public EventCallback<(int Id, string? Valor)> OnAlterarDose { get; set; }

    private string? ObterDose(int produtoId)
    {
        decimal? dose = Doses.GetValueOrDefault(produtoId);
        return dose?.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }
}
