@page "/produtos/{Id:int}"
@inject IDbContextFactory<GadoContext> DbFactory

<PageTitle>@(produto?.Nome ?? "Produto") | Gado em Dia</PageTitle>

@if (naoEncontrado)
{
    <RegistroNaoEncontrado Mensagem="Produto não encontrado." VoltarUrl="produtos" />
}
else if (produto is null)
{
    <p class="text-muted">Carregando...</p>
}
else
{
    <div class="cabecalho-pagina">
        <div>
            <h1>@produto.Nome</h1>
            <p class="text-muted mb-0">@produto.Tipo.ObterNome()</p>
        </div>
        <div class="d-flex gap-2">
            <a href="produtos" class="btn btn-light">Voltar</a>
            <a href="produtos/editar/@produto.Id" class="btn btn-primary">Editar</a>
        </div>
    </div>

    <Cartao Titulo="Dados do produto" Icone="capsule">
        <dl class="row dados mb-0">
            <dt class="col-sm-4">Finalidade</dt>
            <dd class="col-sm-8">@(produto.Finalidade ?? "Não informada")</dd>
            <dt class="col-sm-4">Fabricante</dt>
            <dd class="col-sm-8">@(produto.Fabricante ?? "Não informado")</dd>
            <dt class="col-sm-4">Unidade</dt>
            <dd class="col-sm-8">@produto.Unidade</dd>
            <dt class="col-sm-4">Reforço</dt>
            <dd class="col-sm-8">@(produto.IntervaloReforcoDias == 0 ? "Sem reforço programado" : $"A cada {produto.IntervaloReforcoDias} dias")</dd>
            <dt class="col-sm-4">Carência</dt>
            <dd class="col-sm-8">@produto.CarenciaDias dias</dd>
        </dl>
    </Cartao>

    <Cartao Titulo="Histórico de aplicações" Icone="clipboard2-check">
        @if (!aplicacoes.Any())
        {
            <AvisoVazio Mensagem="Nenhuma aplicação registrada." />
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var aplicacao in aplicacoes)
                {
                    <li class="list-group-item px-0">
                        <strong>@aplicacao.Data.ToString("dd/MM/yyyy")</strong>
                        — @aplicacao.Bovino?.Identificacao — @aplicacao.Aplicador?.Nome
                    </li>
                }
            </ul>
        }
    </Cartao>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Produto? produto;
    private List<Aplicacao> aplicacoes = [];
    private bool naoEncontrado;

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        produto = await db.Produtos.AsNoTracking().FirstOrDefaultAsync(p => p.Id == Id);
        naoEncontrado = produto is null;

        if (naoEncontrado)
        {
            return;
        }

        aplicacoes = await db.Aplicacoes
            .Include(a => a.Bovino)
            .Include(a => a.Aplicador)
            .Include(a => a.Itens)
                .ThenInclude(i => i.Produto)
            .Where(a => a.Itens.Any(i => i.ProdutoId == Id))
            .OrderByDescending(a => a.Data)
            .AsNoTracking()
            .ToListAsync();
    }
}
