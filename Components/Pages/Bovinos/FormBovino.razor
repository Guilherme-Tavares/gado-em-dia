@page "/bovinos/novo"
@page "/bovinos/editar/{Id:int}"
@inject IDbContextFactory<GadoContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>@Titulo | Gado em Dia</PageTitle>

<div class="cabecalho-pagina">
    <div>
        <h1>@Titulo</h1>
        <p class="text-muted mb-0">Só a identificação e o sexo são obrigatórios.</p>
    </div>
    <a href="bovinos" class="btn btn-light">
        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Voltar
    </a>
</div>

@if (naoEncontrado)
{
    <RegistroNaoEncontrado Mensagem="Bovino não encontrado." VoltarUrl="bovinos" />
}
else if (bovino is null)
{
    <p class="text-muted">Carregando...</p>
}
else
{
    <Cartao Titulo="Dados do animal" Icone="tags">
        <EditForm Model="bovino" OnValidSubmit="SalvarAsync">
            <DataAnnotationsValidator />

            <div class="row g-3">
                <div class="col-md-6">
                    <label for="identificacao" class="form-label">Identificação *</label>
                    <InputText id="identificacao" class="form-control" @bind-Value="bovino.Identificacao"
                               placeholder="Nome, apelido, número ou brinco" />
                    <ValidationMessage For="() => bovino.Identificacao" />
                    @if (erroIdentificacao is not null)
                    {
                        <div class="validation-message">@erroIdentificacao</div>
                    }
                </div>

                <div class="col-md-3">
                    <label for="sexo" class="form-label">Sexo *</label>
                    <InputSelect id="sexo" class="form-select" @bind-Value="bovino.Sexo">
                        <option value="">Selecione...</option>
                        @foreach (var sexo in Enum.GetValues<Sexo>())
                        {
                            <option value="@sexo">@sexo.ObterNome()</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => bovino.Sexo" />
                </div>

                <div class="col-md-3">
                    <label for="categoria" class="form-label">Categoria</label>
                    <InputSelect id="categoria" class="form-select" @bind-Value="bovino.Categoria">
                        <option value="">Não informada</option>
                        @foreach (var categoria in Enum.GetValues<Categoria>())
                        {
                            <option value="@categoria">@categoria.ObterNome()</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label for="raca" class="form-label">Raça</label>
                    <InputText id="raca" class="form-control" @bind-Value="bovino.Raca" placeholder="Ex.: Nelore, Mestiço" />
                    <ValidationMessage For="() => bovino.Raca" />
                </div>

                <div class="col-md-4">
                    <label for="nascimento" class="form-label">Data de nascimento</label>
                    <InputDate id="nascimento" class="form-control" @bind-Value="bovino.DataNascimento" />
                    <ValidationMessage For="() => bovino.DataNascimento" />
                </div>

                <div class="col-md-4">
                    <label for="peso" class="form-label">Peso (kg)</label>
                    <InputNumber id="peso" class="form-control" @bind-Value="bovino.PesoKg" step="0.01"
                                 ParsingErrorMessage="O peso deve ser um número." />
                    <ValidationMessage For="() => bovino.PesoKg" />
                </div>

                <div class="col-md-4">
                    <label for="situacao" class="form-label">Situação</label>
                    <InputSelect id="situacao" class="form-select" @bind-Value="bovino.Situacao">
                        @foreach (var situacao in Enum.GetValues<SituacaoBovino>())
                        {
                            <option value="@situacao">@situacao.ObterNome()</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-12">
                    <label for="observacoes" class="form-label">Observações</label>
                    <InputTextArea id="observacoes" class="form-control" rows="3" @bind-Value="bovino.Observacoes"
                                   placeholder="Pelagem, marcas, características" />
                    <ValidationMessage For="() => bovino.Observacoes" />
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>Salvar
                </button>
                <a href="bovinos" class="btn btn-light">Cancelar</a>
            </div>
        </EditForm>
    </Cartao>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private Bovino? bovino;
    private bool naoEncontrado;
    private string? erroIdentificacao;

    private string Titulo => Id is null ? "Novo bovino" : "Editar bovino";

    protected override async Task OnParametersSetAsync()
    {
        naoEncontrado = false;
        erroIdentificacao = null;

        if (Id is null)
        {
            bovino = new Bovino();
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        bovino = await db.Bovinos.AsNoTracking().FirstOrDefaultAsync(b => b.Id == Id);
        naoEncontrado = bovino is null;
    }

    private async Task SalvarAsync()
    {
        if (bovino is null)
        {
            return;
        }

        erroIdentificacao = null;
        bovino.Identificacao = bovino.Identificacao.Trim();
        bovino.Raca = string.IsNullOrWhiteSpace(bovino.Raca) ? null : bovino.Raca.Trim();
        bovino.Observacoes = string.IsNullOrWhiteSpace(bovino.Observacoes) ? null : bovino.Observacoes.Trim();

        await using var db = await DbFactory.CreateDbContextAsync();

        bool identificacaoRepetida = await db.Bovinos
            .AnyAsync(b => b.Id != bovino.Id && b.Identificacao == bovino.Identificacao);
        if (identificacaoRepetida)
        {
            erroIdentificacao = "Já existe um bovino com essa identificação.";
            return;
        }

        if (bovino.Id == 0)
        {
            db.Bovinos.Add(bovino);
        }
        else
        {
            db.Bovinos.Update(bovino);
        }

        await db.SaveChangesAsync();
        Navigation.NavigateTo($"bovinos/{bovino.Id}");
    }
}
